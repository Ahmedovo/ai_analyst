# Environments
# NOTE: the backend now lives inside .venv/ alongside the environment.
# Ignore the environment internals (Lib, Scripts, ...) but keep the moved
# backend source tracked.
.venv/*
!.venv/app/
!.venv/tests/
!.venv/data/
!.venv/generated/
!.venv/requirements.txt
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets
.env

# Generated artifacts
.venv/generated/charts/*
.venv/generated/reports/*
!.venv/generated/charts/.gitkeep
!.venv/generated/reports/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
